# Copy this file to backend/.env. Never commit the real backend/.env file.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
TAVILY_API_KEY=

# External research is off by default and still requires explicit caller consent.
REALDOOR_EXTERNAL_REFERENCE_RESEARCH_ENABLED=false

# The risk branch exposes the module; set false for an administrator kill switch.
REALDOOR_RENTER_BUDGET_ENABLED=true
